# general
ENV=development                      # development | production
FRONTEND_URL=http://localhost:5173   # allowed CORS origin

# database / queue
DATABASE_URL=postgresql+psycopg://agoranote:agoranote@db:5432/agoranote
REDIS_URL=redis://redis:6379/0

# auth
AUTH_MODE=dev                        # dev | clerk | supabase
AUTH_JWKS_URL=
AUTH_ISSUER=

# storage
STORAGE_BACKEND=local                # local | r2
LOCAL_STORAGE_DIR=/data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI
LLM_PROVIDER=mock                    # mock | (decided in Phase 6)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
TRANSCRIBE_PROVIDER=mock             # mock | (decided in Phase 7)
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=

# limits
MAX_FILES_PER_SET=5
MAX_FILE_MB=200
MAX_INPUT_CHARS=200000

# frontend (Vite, read at build time)
VITE_API_URL=http://localhost:8000
VITE_AUTH_MODE=dev
