# general
ENV=development                      # development | production
FRONTEND_URL=http://localhost:5173   # allowed CORS origin

# database / queue
DATABASE_URL=postgresql+psycopg://agoranote:agoranote@db:5432/agoranote
REDIS_URL=redis://redis:6379/0

# auth
AUTH_MODE=dev                        # dev | clerk | supabase
AUTH_JWKS_URL=
AUTH_ISSUER=

# storage
STORAGE_BACKEND=local                # local | r2
LOCAL_STORAGE_DIR=/data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI
# LLM_PROVIDER=mock works offline with no keys. LLM_PROVIDER=openai means any OpenAI-compatible
# Chat Completions API. Local Ollama on the host machine (see README):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:UD-Q4_K_XL
#   LLM_API_KEY=                     (Ollama ignores it)
#   LLM_REASONING_EFFORT=none
# Hosted later: LLM_BASE_URL=https://api.openai.com/v1 or https://openrouter.ai/api/v1, plus a real
# LLM_API_KEY and that provider's model name.
LLM_PROVIDER=mock                    # mock | openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=600              # per call; local models need minutes
# Sent as "reasoning_effort" when set. "none" for the local Gemma model: no hidden "thinking", ~1.5x
# faster with the same quality in our tests. Leave empty for providers/models that don't accept it.
LLM_REASONING_EFFORT=
# TRANSCRIBE_PROVIDER=openai means any OpenAI-compatible /audio/transcriptions API. Local Whisper via
# speaches (start it with `docker compose --profile gpu up`, see README):
#   TRANSCRIBE_PROVIDER=openai
#   TRANSCRIBE_BASE_URL=http://speaches:8000/v1
#   TRANSCRIBE_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
#   TRANSCRIBE_VAD_FILTER=true       (speaches only: skips silence; leave false for OpenAI)
#   COMPOSE_PROFILES=gpu             (then a plain `docker compose up` starts speaches too)
# Hosted later: TRANSCRIBE_BASE_URL=https://api.openai.com/v1, TRANSCRIBE_MODEL=whisper-1, a real key.
TRANSCRIBE_PROVIDER=mock             # mock | openai
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_TIMEOUT_SECONDS=600       # per 10-minute segment
TRANSCRIBE_VAD_FILTER=false

# true when the local LLM (Ollama) and local Whisper share one GPU: they then take turns, and the LLM
# is unloaded before transcribing. false for hosted APIs.
SHARED_GPU=false

# limits
MAX_FILES_PER_SET=5
MAX_FILE_MB=200
MAX_INPUT_CHARS=200000

# frontend (Vite, read at build time)
VITE_API_URL=http://localhost:8000
VITE_AUTH_MODE=dev
